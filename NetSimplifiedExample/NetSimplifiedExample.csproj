<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\tModLoader.targets" />
  <ItemGroup>
    <ProjectReference Include="..\src\NetSimplified.csproj">
      <Project>{00000000-0000-0000-0000-000000000000}</Project>
      <Name>NetSimplified</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="AutoSyncTypes\" />
  </ItemGroup>

  <Target Name="CopyOutputToSubmodLib" AfterTargets="Build">
    <!-- 在构建后将生成的 dll 和 xml 复制到 NetSimpExSubmod/lib -->
    <PropertyGroup>
      <SubmodLibDir>$(MSBuildThisFileDirectory)..\NetSimpExSubmod\lib\</SubmodLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(SubmodLibDir)" Condition="!Exists('$(SubmodLibDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SubmodLibDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).xml" DestinationFolder="$(SubmodLibDir)" Condition="Exists('$(TargetDir)$(AssemblyName).xml')" SkipUnchangedFiles="true" />
  </Target>
</Project>